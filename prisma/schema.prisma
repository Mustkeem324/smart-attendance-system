datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  TEAM_MANAGER
  EMPLOYEE
  SALES_MANAGER
  FIELD_SALES_REP
  DELIVERY_AGENT
  INVENTORY_MANAGER
  RETAILER
  DISTRIBUTOR
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  EARLY_DEPARTURE
  ON_LEAVE
  WORK_FROM_HOME
  WEEKLY_OFF
  PUBLIC_HOLIDAY
  MISSED_PUNCH
  PENDING_APPROVAL
}

enum EventType {
  CHECK_IN
  CHECK_OUT
  BREAK_START
  BREAK_END
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ALERT
}

enum ShiftType {
  FIXED
  FLEXIBLE
  ROTATIONAL
  NIGHT
  SPLIT
  CUSTOM
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  FINALIZED
  PAID
  REJECTED
}

enum LeaveLedgerType {
  CREDIT
  DEBIT
  REVERSAL
  ENCASHMENT
  ADJUSTMENT
}

enum DeliveryStatus {
  DRAFT
  SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CREDIT
}

enum StockMovementType {
  INWARD
  DELIVERY_OUT
  RETURN_IN
  DAMAGE_OUT
  ADJUSTMENT
}

enum ShopCategory {
  GROCERY
  SUPERMARKET
  CONVENIENCE
  PHARMACY
  ELECTRONICS
  WHOLESALE
  GENERAL
}

enum PhotoCategory {
  SHOP_FRONT
  DELIVERED_PRODUCTS
  SHELF_DISPLAY
  RECEIPT
  CUSTOMER_PROOF
}

model Organization {
  id              String            @id @default(uuid())
  name            String
  code            String            @unique
  slug            String            @unique
  email           String
  phone           String?
  address         String?
  logo            String?
  isActive        Boolean           @default(true)
  settings        Json?             // geofence defaults, grace periods, etc.
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  users                 User[]
  branches              Branch[]
  officeLocations       OfficeLocation[]
  departments           Department[]
  shifts                Shift[]
  leaveTypes            LeaveType[]
  holidays              Holiday[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  payrollRecords        PayrollRecord[]
  attendanceRecords     AttendanceRecord[]
  attendanceExceptions  AttendanceException[]
  leaveRequests         LeaveRequest[]
  leavePolicies         LeavePolicy[]
  leaveLedgers          LeaveLedger[]
  compensatoryOffs      CompensatoryOff[]
  leaveEncashments      LeaveEncashment[]
  reportSchedules       ReportSchedule[]
  reportFiles           ReportFile[]
  importJobs            ImportJob[]
  shiftAssignments      ShiftAssignment[]
  shiftRotations        ShiftRotation[]
  shiftRosters          ShiftRoster[]
  shiftSwapRequests     ShiftSwapRequest[]
  overtimeRecords       OvertimeRecord[]
  salaryStructures      SalaryStructure[]
  payrollPeriods        PayrollPeriod[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  employeeLoans         EmployeeLoan[]
  reimbursementClaims   ReimbursementClaim[]
  taxDeclarations       TaxDeclaration[]
  shops                 Shop[]
  shopAssignments       ShopAssignment[]
  shopVisits            ShopVisit[]
  productCategories     ProductCategory[]
  products              Product[]
  warehouses            Warehouse[]
  inventories           Inventory[]
  stockMovements        StockMovement[]
  deliveries            Delivery[]
  paymentCollections    PaymentCollection[]
  deliveryAuditLogs     DeliveryAuditLog[]
  salesTargets          SalesTarget[]
  salesProfiles         SalesRepresentativeProfile[]

  @@map("organizations")
}

model Branch {
  id              String            @id @default(uuid())
  organizationId  String
  name            String
  code            String
  address         String
  city            String?
  country         String            @default("India")
  latitude        Float
  longitude       Float
  radiusMeters    Int               @default(50) // Default 50m geofence radius
  timezone        String            @default("Asia/Kolkata")
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees       Employee[]
  officeLocations OfficeLocation[]
  holidays        Holiday[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model OfficeLocation {
  id                    String              @id @default(uuid())
  organizationId        String
  branchId              String?
  name                  String
  code                  String
  address               String
  latitude              Float
  longitude             Float
  radiusMeters          Int                 @default(50) // Default 50m, 100m, custom
  minGpsAccuracyMeters  Int                 @default(30) // Minimum GPS accuracy setting
  allowedTimeWindows    String?             @default("00:00-23:59")
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employees             Employee[]
  attendanceRecords     AttendanceRecord[]
  attendanceEvents      AttendanceEvent[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@map("office_locations")
}

model Department {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  code            String
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees       Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Shift {
  id                    String        @id @default(uuid())
  organizationId        String
  name                  String
  code                  String
  startTime             String        // HH:mm (e.g. "09:00")
  endTime               String        // HH:mm (e.g. "18:00")
  gracePeriodMinutes    Int           @default(15) // Grace time before marked Late
  halfDayThresholdHours Float         @default(4.5)
  fullDayThresholdHours Float         @default(8.0)
  isOvernight           Boolean       @default(false)
  isFlexible            Boolean       @default(false)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees             Employee[]
  shiftAssignments      ShiftAssignment[]
  shiftRosterEntries    ShiftRosterEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("shifts")
}

model User {
  id              String         @id @default(uuid())
  organizationId  String
  email           String
  phone           String?
  passwordHash    String
  role            Role           @default(EMPLOYEE)
  isActive        Boolean        @default(true)
  twoFactorEnabled Boolean       @default(false)
  twoFactorSecret String?
  refreshToken    String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee?
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@map("users")
}

model Employee {
  id                String            @id @default(uuid())
  userId            String            @unique
  organizationId    String
  employeeCode      String            // e.g. EMP-001
  firstName         String
  lastName          String
  email             String
  phone             String?
  profilePhoto      String?           // photo URL or base64
  address           String?
  emergencyContact  String?
  designation       String
  departmentId      String
  branchId          String
  officeLocationId  String?
  shiftId           String
  managerId         String?
  joiningDate       DateTime
  probationEndDate  DateTime?
  resignationDate   DateTime?
  lastWorkingDay    DateTime?
  employmentType    EmploymentType    @default(FULL_TIME)
  employmentStatus  EmploymentStatus  @default(ACTIVE)
  weeklyOff         String            @default("SUNDAY") // e.g. "SUNDAY" or "SATURDAY,SUNDAY"
  baseSalary        Float?            @default(0)
  bankAccountDetails Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department            Department            @relation(fields: [departmentId], references: [id])
  branch                Branch                @relation(fields: [branchId], references: [id])
  officeLocation        OfficeLocation?       @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  shift                 Shift                 @relation(fields: [shiftId], references: [id])
  manager               Employee?             @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates          Employee[]            @relation("ManagerSubordinates")

  attendanceRecords     AttendanceRecord[]
  attendanceEvents      AttendanceEvent[]
  attendanceCorrections AttendanceCorrection[]
  attendanceExceptions  AttendanceException[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  leaveLedgers          LeaveLedger[]
  leaveApprovals        LeaveApproval[]
  compensatoryOffs      CompensatoryOff[]
  leaveEncashments      LeaveEncashment[]
  shiftAssignments      ShiftAssignment[]
  shiftRosterEntries    ShiftRosterEntry[]
  shiftSwapRequestsFrom ShiftSwapRequest[]    @relation("SwapRequestFrom")
  shiftSwapRequestsTo   ShiftSwapRequest[]    @relation("SwapRequestTo")
  breakRecords          BreakRecord[]
  overtimeRecords       OvertimeRecord[]
  salaryAssignments     EmployeeSalaryAssignment[]
  payrollEmployeeRecords PayrollEmployeeRecord[]
  payslips              Payslip[]
  employeeLoans         EmployeeLoan[]
  reimbursementClaims   ReimbursementClaim[]
  taxDeclarations       TaxDeclaration[]
  devices               Device[]
  payrollRecords        PayrollRecord[]
  assignedShops         Shop[]
  shopAssignments       ShopAssignment[]
  shopVisits            ShopVisit[]
  deliveries            Delivery[]
  paymentCollections    PaymentCollection[]
  salesTargets          SalesTarget[]
  salesProfile          SalesRepresentativeProfile?

  @@unique([organizationId, employeeCode])
  @@index([organizationId, departmentId])
  @@index([organizationId, branchId])
  @@index([organizationId, officeLocationId])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, joiningDate])
  @@index([organizationId, resignationDate])
  @@index([managerId])
  @@map("employees")
}

model AttendanceRecord {
  id                    String            @id @default(uuid())
  organizationId        String
  employeeId            String
  officeLocationId      String?
  date                  String            // YYYY-MM-DD format
  checkInTime           DateTime?
  checkOutTime          DateTime?
  totalHours            Float             @default(0.0)
  totalBreakMinutes     Int               @default(0)
  overtimeHours         Float             @default(0.0)
  status                AttendanceStatus  @default(ABSENT)
  lateMinutes           Int               @default(0)
  earlyDepartureMinutes Int               @default(0)
  isVerified            Boolean           @default(false)

  // Check In GPS & Verification
  checkInLatitude       Float?
  checkInLongitude      Float?
  checkInAccuracy       Float?
  checkInDistanceMeters Float?
  checkInWithinGeofence Boolean?
  checkInMockDetected   Boolean           @default(false)
  checkInPhoto          String?           // Selfie URL or base64

  // Check Out GPS & Verification
  checkOutLatitude       Float?
  checkOutLongitude      Float?
  checkOutAccuracy       Float?
  checkOutDistanceMeters Float?
  checkOutWithinGeofence Boolean?
  checkOutPhoto          String?

  // Flags & Metadata
  isManualEntry         Boolean           @default(false)
  correctedByUserId     String?
  correctionReason      String?
  adminNotes            String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  officeLocation        OfficeLocation?   @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  events                AttendanceEvent[]
  corrections           AttendanceCorrection[]
  exceptions            AttendanceException[]

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, date, status])
  @@index([organizationId, status])
  @@index([employeeId, date])
  @@index([officeLocationId])
  @@index([status])
  @@map("attendance_records")
}

model AttendanceEvent {
  id                    String            @id @default(uuid())
  attendanceRecordId    String
  employeeId            String
  officeLocationId      String?
  eventType             EventType
  timestamp             DateTime          @default(now())
  latitude              Float?
  longitude             Float?
  accuracy              Float?
  distanceMeters        Float?
  isWithinGeofence      Boolean           @default(false)
  isMockDetected        Boolean           @default(false)
  photo                 String?
  ipAddress             String?
  userAgent             String?
  deviceId              String?

  attendanceRecord      AttendanceRecord  @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  officeLocation        OfficeLocation?   @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)

  @@index([attendanceRecordId])
  @@index([employeeId, timestamp])
  @@map("attendance_events")
}

model AttendanceCorrection {
  id                    String            @id @default(uuid())
  attendanceRecordId    String
  employeeId            String
  requestedCheckIn      DateTime?
  requestedCheckOut     DateTime?
  reason                String
  status                RequestStatus     @default(PENDING)
  reviewedByUserId      String?
  reviewRemark          String?
  reviewedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  attendanceRecord      AttendanceRecord  @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId])
  @@index([employeeId, status])
  @@map("attendance_corrections")
}

model AttendanceException {
  id                    String            @id @default(uuid())
  organizationId        String
  employeeId            String
  attendanceRecordId    String?
  exceptionDate         String            // YYYY-MM-DD
  reason                String            // GPS_UNAVAILABLE, OUTSIDE_GEOFENCE, CAMERA_FAILURE, MISSED_CHECK_IN, MISSED_CHECK_OUT, TEMPORARY_RELOCATION, OTHER
  explanation           String
  supportingDocument    String?
  status                RequestStatus     @default(PENDING) // PENDING, APPROVED, REJECTED, CANCELLED
  reviewedByUserId      String?
  reviewRemark          String?
  reviewedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecord      AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId, exceptionDate])
  @@map("attendance_exceptions")
}

model LeaveType {
  id                  String         @id @default(uuid())
  organizationId      String
  name                String         // e.g. "Casual Leave", "Sick Leave"
  code                String         // e.g. "CL", "SL"
  description         String?
  maxDaysPerYear      Float          @default(12)
  isPaid              Boolean        @default(true)
  requiresAttachment  Boolean        @default(false)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  policies            LeavePolicy[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

model LeaveBalance {
  id              String         @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  year            Int
  totalQuota      Float
  usedDays        Float          @default(0)
  pendingDays     Float          @default(0)
  remainingDays   Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType      @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id                  String         @id @default(uuid())
  organizationId      String
  employeeId          String
  leaveTypeId         String
  startDate           DateTime
  endDate             DateTime
  totalDays           Float
  isHalfDay           Boolean        @default(false)
  halfDayPeriod       String?        // "FIRST_HALF" or "SECOND_HALF"
  reason              String
  documentUrl         String?
  status              RequestStatus  @default(PENDING)
  reviewedByUserId    String?
  reviewRemark        String?
  reviewedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee            Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType           LeaveType      @relation(fields: [leaveTypeId], references: [id])
  approvals           LeaveApproval[]

  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
  @@index([employeeId, startDate, endDate])
  @@map("leave_requests")
}

model Holiday {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  date            String         // YYYY-MM-DD
  isOptional      Boolean        @default(false)
  isRecurring     Boolean        @default(false)
  branchId        String?        // null means applied to all branches in org
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, date, name])
  @@index([organizationId, date])
  @@map("holidays")
}

model Device {
  id                String         @id @default(uuid())
  employeeId        String
  deviceIdentifier  String
  deviceModel       String?
  os                String?
  browser           String?
  ipAddress         String?
  lastUsedAt        DateTime       @default(now())
  isTrusted         Boolean        @default(true)
  isBlocked         Boolean        @default(false)
  createdAt         DateTime       @default(now())

  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, deviceIdentifier])
  @@index([employeeId])
  @@map("devices")
}

model Notification {
  id              String            @id @default(uuid())
  organizationId  String
  userId          String
  title           String
  message         String
  type            NotificationType  @default(INFO)
  isRead          Boolean           @default(false)
  link            String?
  createdAt       DateTime          @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id              String         @id @default(uuid())
  organizationId  String
  userId          String?
  action          String         // e.g. "CREATE_EMPLOYEE", "APPROVE_LEAVE", "MANUAL_ATTENDANCE_CORRECTION"
  entity          String         // e.g. "Employee", "AttendanceRecord", "LeaveRequest"
  entityId        String?
  oldValues       Json?
  newValues       Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime       @default(now())

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entity])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PayrollRecord {
  id                String         @id @default(uuid())
  organizationId    String
  employeeId        String
  month             Int            // 1 - 12
  year              Int
  totalWorkingDays  Int
  presentDays       Float
  paidLeaveDays     Float
  unpaidLeaveDays   Float
  lateDays          Int            @default(0)
  overtimeHours     Float          @default(0.0)
  baseSalary        Float
  allowances        Float          @default(0)
  deductions        Float          @default(0)
  netSalary         Float
  status            String         @default("PROCESSED") // DRAFT, PROCESSED, PAID
  generatedAt       DateTime       @default(now())

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([organizationId, month, year])
  @@map("payroll_records")
}

model LeavePolicy {
  id                        String        @id @default(uuid())
  organizationId            String
  leaveTypeId               String
  name                      String
  annualAllocation          Float         @default(12)
  monthlyAccrual            Float         @default(1.0)
  minDaysPerRequest         Float         @default(0.5)
  maxDaysPerRequest         Float         @default(30)
  allowHalfDay              Boolean       @default(true)
  allowCarryForward         Boolean       @default(true)
  maxCarryForwardDays       Float         @default(10)
  carryForwardExpiryMonths  Int           @default(6)
  requiresDocument          Boolean       @default(false)
  documentRequiredAfterDays Float         @default(3)
  eligibleEmploymentTypes   String        @default("FULL_TIME,PROBATION")
  isActive                  Boolean       @default(true)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  organization              Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveType                 LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("leave_policies")
}

model LeaveApproval {
  id                    String        @id @default(uuid())
  leaveRequestId        String
  approverUserId        String
  approverEmployeeId    String?
  level                 Int           @default(1) // 1 = Manager, 2 = HR, 3 = Admin
  status                RequestStatus @default(PENDING)
  remarks               String?
  reviewedAt            DateTime?
  createdAt             DateTime      @default(now())

  leaveRequest          LeaveRequest  @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approverEmployee      Employee?     @relation(fields: [approverEmployeeId], references: [id], onDelete: SetNull)

  @@index([leaveRequestId])
  @@index([approverUserId, status])
  @@map("leave_approvals")
}

model LeaveLedger {
  id                    String          @id @default(uuid())
  organizationId        String
  employeeId            String
  leaveTypeId           String
  transactionType       LeaveLedgerType
  days                  Float
  balanceBefore         Float
  balanceAfter          Float
  referenceId           String?         // e.g. leaveRequestId or compOffId
  reason                String
  createdAt             DateTime        @default(now())

  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@index([employeeId, leaveTypeId])
  @@map("leave_ledgers")
}

model CompensatoryOff {
  id                    String        @id @default(uuid())
  organizationId        String
  employeeId            String
  workedDate            String        // YYYY-MM-DD
  hoursWorked           Float         @default(8.0)
  daysGranted           Float         @default(1.0)
  reason                String
  status                RequestStatus @default(PENDING)
  expiresAt             DateTime?
  reviewedByUserId      String?
  reviewRemark          String?
  reviewedAt            DateTime?
  createdAt             DateTime      @default(now())

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([employeeId, workedDate])
  @@map("compensatory_offs")
}

model LeaveEncashment {
  id                    String        @id @default(uuid())
  organizationId        String
  employeeId            String
  leaveTypeId           String
  daysToEncash          Float
  perDayRate            Float
  totalAmount           Float
  status                RequestStatus @default(PENDING)
  reviewedByUserId      String?
