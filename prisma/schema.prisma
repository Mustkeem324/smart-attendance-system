  reason                String
  createdAt             DateTime          @default(now())

  delivery              Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("delivery_revisions")
}

model PaymentCollection {
  id                    String            @id @default(uuid())
  organizationId        String
  shopId                String
  deliveryId            String?
  employeeId            String
  amount                Float
  paymentMode           PaymentMode       @default(CASH)
  paymentReference      String?
  paymentProofUrl       String?
  collectedDate         String            // YYYY-MM-DD
  notes                 String?
  isVerified            Boolean           @default(false)
  createdAt             DateTime          @default(now())

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shop                  Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  delivery              Delivery?         @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, collectedDate])
  @@index([shopId])
  @@index([employeeId])
  @@map("payment_collections")
}

model DeliveryAuditLog {
  id                    String            @id @default(uuid())
  organizationId        String
  deliveryId            String?
  userId                String?
  action                String
  details               Json?
  ipAddress             String?
  createdAt             DateTime          @default(now())

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([deliveryId])
  @@map("delivery_audit_logs")
}

model SalesTarget {
  id                    String            @id @default(uuid())
  organizationId        String
  employeeId            String
  month                 Int               // 1 - 12
  year                  Int               // e.g. 2026
  targetVisits          Int               @default(50)
  targetDeliveries      Int               @default(30)
  targetTurnover        Float             @default(150000.0)
  achievedVisits        Int               @default(0)
  achievedDeliveries    Int               @default(0)
  achievedTurnover      Float             @default(0.0)
  status                String            @default("ACTIVE") // ACTIVE, ACHIEVED, MISSED
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, month, year])
  @@index([organizationId, year, month])
  @@index([employeeId])
  @@map("sales_targets")
}

model SalesRepresentativeProfile {
  id                    String            @id @default(uuid())
  organizationId        String
  employeeId            String            @unique
  territory             String            @default("Central Zone")
  vehicleNumber         String?
  vehicleType           String?           // Bike, Van, Car
  commissionRatePercent Float             @default(2.5)
  assignedWarehouseId   String?
  dailyVisitTarget      Int               @default(10)
  monthlySalesTarget    Float             @default(150000.0)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  warehouse             Warehouse?        @relation(fields: [assignedWarehouseId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("sales_representative_profiles")
}
