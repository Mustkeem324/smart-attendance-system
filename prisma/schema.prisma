model PayrollEmployeeRecord {
  id                    String          @id @default(uuid())
  payrollRunId          String
  employeeId            String
  totalWorkingDays      Int             @default(30)
  payableDays           Float           @default(30.0)
  presentDays           Float           @default(0.0)
  paidLeaveDays         Float           @default(0.0)
  unpaidLeaveDays       Float           @default(0.0)
  holidays              Float           @default(0.0)
  weeklyOffs            Float           @default(0.0)
  overtimeHours         Float           @default(0.0)
  overtimeAmount        Float           @default(0.0)

  // Earnings
  basicSalary           Float           @default(0.0)
  hra                   Float           @default(0.0)
  da                    Float           @default(0.0)
  specialAllowance      Float           @default(0.0)
  incentives            Float           @default(0.0)
  grossSalary           Float           @default(0.0)

  // Deductions
  pfDeduction           Float           @default(0.0)
  esiDeduction          Float           @default(0.0)
  professionalTax       Float           @default(0.0)
  tdsDeduction          Float           @default(0.0)
  loanRecovery          Float           @default(0.0)
  lwpDeduction          Float           @default(0.0)
  totalDeductions       Float           @default(0.0)

  // Net Pay: Gross - Deductions
  netSalary             Float           @default(0.0)
  paymentStatus         String          @default("UNPAID") // UNPAID, PAID
  paymentMethod         String          @default("BANK_TRANSFER")
  paymentReference      String?
  createdAt             DateTime        @default(now())

  payrollRun            PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@map("payroll_employee_records")
}

